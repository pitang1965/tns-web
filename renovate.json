{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["staging"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 4am on monday"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "matchPackageNames": [
        "next",
        "eslint-config-next",
        "react",
        "react-dom",
        "mongoose",
        "mongodb",
        "@auth0/nextjs-auth0",
        "@sentry/nextjs",
        "mapbox-gl"
      ],
      "groupName": null
    }
  ]
}
